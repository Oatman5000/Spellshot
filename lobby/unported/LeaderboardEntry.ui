@Stat = Group {
  LayoutMode: Left;
  Padding: (Right: 20);
  Group #Icon {
    Anchor: (Width: 24, Height: 24);
    Background: "../Images/Skull.png";
  }
  Label #Value {
    Text: "0";
    Style: (FontSize: 18, TextColor: #a9afaa, VerticalAlignment: Center, RenderBold: true);
    Padding: (Top: 1, Left: 5);
  }
};

Group {
  Padding: (Top: 10);
  Button #Button {
    Anchor: (Width: 1430, Height: 55);
    Background: (TexturePath: "../Images/LeaderboardEntry.png");
    Group {
      LayoutMode: Left;
      Group #Trophy {
        Background: "../Images/SilverTrophy.png";
        Anchor: (Width: 24, Height: 24, Left: 20);
      }
      Label #Rank {
        Text: "#1";
        Style: (FontSize: 18, TextColor: #a9afaa, VerticalAlignment: Center, RenderBold: true);
        Padding: (Top: 1, Left: 20);
      }
      Label #Name {
        Text: "burnboy";
        Style: (FontSize: 18, TextColor: #a9afaa, VerticalAlignment: Center, RenderBold: true);
        Padding: (Top: 1, Left: 20);
      }
    }
    Group {
      LayoutMode: Right;
      Padding: (Right: 20);
      @Stat #Kills {
        #Icon {
          Background: "../Images/Skull.png";
        }
        #Value {
          Text: "1500";
        }
      }
      @Stat #Deaths {
        #Icon {
          Background: "../Images/Dead.png";
        }
        #Value {
          Text: "5";
        }
      }
      @Stat #KD {
        #Icon {
          Background: "../Images/Division.png";
        }
        #Value {
          Text: "0.25";
        }
      }

    }
  }
}