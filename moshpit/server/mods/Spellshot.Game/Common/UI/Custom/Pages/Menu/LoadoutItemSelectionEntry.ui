@ButtonSounds = (
  Activate: (
    SoundPath: "../../Sounds/UI_Button_Click.ogg",
    Volume: 0.15
  ),
  MouseHover: (
    SoundPath: "../../Sounds/UI_Button_Hover.ogg",
    Volume: 0.15
  )
);

Group {
  Padding: (Vertical: 3);
  Button #Button {
    Anchor: (Width: 300, Height: 60);
    // Matches @ListItem in MenuCommon.ui and the loadout cards -- see the note
    // there. Border 24 needs the row to stay at least 48px tall.
    Style: (
      Default: (Background: (TexturePath: "../../Images/Hextech/Slot.png", Border: 24)),
      Hovered: (Background: (TexturePath: "../../Images/Hextech/SlotHovered.png", Border: 24)),
      Sounds: @ButtonSounds
    );
    Group {
      Padding: (Horizontal: 28);
      Label #Name {
        Text: "Primary";
        Style: (VerticalAlignment: Center, TextColor: #8FA3B8, RenderBold: true);
      }
      Group #PrimaryIcon {
        Visible: true;
        Anchor: (Width: 100, Height: 100, Right: 0);
        Background: "../../Images/Guns/AR14.png";
      }
      Group #SecondaryIcon {
        Visible: true;
        Anchor: (Width: 50, Height: 50, Right: 0);
        Background: "../../Images/Guns/AR14.png";
      }
      Group #MeleeIcon {
        Visible: true;
        Anchor: (Width: 40, Height: 40, Right: 0);
        Background: "../../Images/Guns/AR14.png";
      }
      Group #UtilityIcon {
        Visible: true;
        Anchor: (Width: 35, Height: 35, Right: 0);
        Background: "../../Images/Guns/AR14.png";
      }
    }
  }
}