$LoadoutEntry = "LoadoutEntry.ui";
$LoadoutEntryLocked = "LoadoutEntryLocked.ui";
$C = "MenuCommon.ui";
$Stats = "Stats.ui";

Group {
  LayoutMode: Full;
  Background: "../../Images/GradientBackground.png";

  Group #Loadouts {
    Padding: (Horizontal: 100);
    LayoutMode: Left;
  }

  // Filled by appending Pages/Menu/Edit.ui when a loadout is clicked, and
  // emptied again on the way out. Deliberately left as a bare container: an
  // element hidden in the batch that creates it is not addressable later on
  // 0.6.0, which disconnected the client. See Edit.ui.
  Group #Edit {
    LayoutMode: Left;
  }

  // Who is online, their K/D this match and their ping. Filled by LoadoutPage on
  // build and emptied when the edit panel opens, so the two never share the screen.
  // Emptied, not hidden: an element hidden in the batch that creates it stops being
  // addressable on 0.6.0, which is what disconnected the client. See Edit.ui.
  // Host for the player list. Empty here: LoadoutPage appends Players.ui into it on
  // build and clears it when a loadout is opened, so the card and its frame come and
  // go together. Nothing is hidden -- see Edit.ui for why.
  //
  // Centred with MiddleCenter, the way Pages/Vote/Menu.ui centres its card, then
  // biased upward by reserving space at the bottom. Anchor Bottom shrinks the box
  // this centres within, so the midpoint rises by half the value: 330 lifts it about
  // 165px and clears the loadout cards. Expressed as a reservation rather than a
  // fixed top offset so it stays put across resolutions.
  Group {
    FlexWeight: 1;
    LayoutMode: MiddleCenter;
    Anchor: (Top: 0, Bottom: 330);

    Group #PlayersHost {
      LayoutMode: Top;
    }
  }
  $Stats.@StatsContainer {}

}

