@ButtonSounds = (
  MouseHover: (
    SoundPath: "../../Sounds/UI_Button_Hover.ogg",
    Volume: 0.15
  )
);

// Slot.png rather than Slim.png: the chamfered octagon is the mod's frame, used
// by the weapon selector, the ammo plate and the loadout cards. Slim.png was a
// plain square with corner dots and was the odd one out.
//
// Border 24 must be <= HALF the rendered size in BOTH axes, so a row using this
// has to stay at least 48px tall -- 60 is fine, do not shrink it below 48.
@ListItem = Group {
  Padding: (Vertical: 3);
  Button #Button {
    Anchor: (Width: 300, Height: 60);
    Style: (
      Default: (Background: (TexturePath: "../../Images/Hextech/Slot.png", Border: 24)),
      Hovered: (Background: (TexturePath: "../../Images/Hextech/SlotHovered.png", Border: 24)),
      Sounds: @ButtonSounds
    );
    Group {
      // 28 not 20: the 24px chamfer eats into the old inset near the corners.
      Padding: (Horizontal: 28);
      Label #Type {
        Text: "Primary";
        Style: (VerticalAlignment: Center, TextColor: #8FA3B8, RenderBold: true);
      }
      Group #Icon {
        Anchor: (Width: 100, Height: 100, Right: 0);
        Background: "../../Images/Guns/AR14.png";
      }
    }
  }
};
